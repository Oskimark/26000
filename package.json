{
  "name": "taxis-recepcion",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de recepción de llamados para empresa de taxis",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "dev:client": "npm --prefix client run dev",
    "db:dev": "node scripts/dev-db.js",
    "build": "npm --prefix client install --include=dev && npm --prefix client run build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "embedded-postgres": "^18.4.0-beta.17"
  }
}
